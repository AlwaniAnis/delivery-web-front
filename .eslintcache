95"],"'validate' is defined but never used.",["396"],"jsx-a11y/anchor-is-valid","The href attribute is required for an anchor to be keyboard accessible. Provide a valid, navigable address as the href value. If you cannot provide an href, but still need the element to resemble a link, use a button and change it with appropriate styles. Learn more: https://github.com/jsx-eslint/eslint-plugin-jsx-a11y/blob/HEAD/docs/rules/anchor-is-valid.md","JSXOpeningElement","'SelectPicker' is defined but never used.","'FileD' is defined but never used.","'BASE_URL' is defined but never used.","react/jsx-no-target-blank","Using target=\"_blank\" without rel=\"noreferrer\" (which implies rel=\"noopener\") is a security risk in older browsers: see https://mathiasbynens.github.io/rel-noopener/#recommendations","noTargetBlankWithoutNoreferrer",{"range":"397","text":"398"},"Expected '!==' and instead saw '!='.","'Tag' is defined but never used.",["399"],"'Input' is defined but never used.","'Pagination' is defined but never used.","'totalCount' is assigned a value but never used.","'settotalCount' is assigned a value but never used.",["400"],"'TagInput' is defined but never used.","'Component' is defined but never used.","React Hook useEffect has a missing dependency: 'getWidth'. Either include it or remove the dependency array.",["401"],"react/no-direct-mutation-state","Do not mutate state directly. Use setState().","MemberExpression","noDirectMutation","'arLocale' is assigned a value but never used.","'Grid' is defined but never used.","'useState' is defined but never used.","'Col' is defined but never used.","'Row' is defined but never used.","'Responsive' is defined but never used.","'style' is assigned a value but never used.","'LineSeries' is defined but never used.","array-callback-return","Array.prototype.map() expects a return value from arrow function.","ArrowFunctionExpression","expectedInside","React Hook useEffect has a missing dependency: 'uploaded'. Either include it or remove the dependency array. If 'setWidth' needs the current value of 'uploaded', you can also switch to useReducer instead of useState and read 'uploaded' in the reducer.",["402"],{"desc":"403","fix":"404"},"no-global-assign","no-unsafe-negation",{"desc":"405","fix":"406"},{"desc":"405","fix":"407"},[5793,5793]," rel=\"noreferrer\"",{"desc":"405","fix":"408"},{"desc":"405","fix":"409"},{"desc":"410","fix":"411"},{"desc":"412","fix":"413"},"Update the dependencies array to be: [location.pathname, logged, setDriversList, setlogged]",{"range":"414","text":"415"},"Update the dependencies array to be: [fetch]",{"range":"416","text":"417"},{"range":"418","text":"417"},{"range":"419","text":"417"},{"range":"420","text":"417"},"Update the dependencies array to be: [state, props, getWidth]",{"range":"421","text":"422"},"Update the dependencies array to be: [name, uploaded]",{"range":"423","text":"424"},[2195,2203],"[location.pathname, logged, setDriversList, setlogged]",[3877,3879],"[fetch]",[3732,3734],[3209,3211],[3146,3148],[761,775],"[state, props, getWidth]",[660,666],"[name, uploaded]"]